# HCM Lite Frontend Environment Template
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# For production deployment on Vercel:
# Set NEXT_PUBLIC_API_URL to your deployed backend URL (e.g. https://your-backend.vercel.app/api)
# Set NEXT_PUBLIC_BACKEND_URL to your deployed backend URL (e.g. https://your-backend.vercel.app)
